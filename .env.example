# Diyanet REST API Proxy Environment Configuration
PORT=3000
DIYANET_EMAIL=your-email@example.com
DIYANET_PASSWORD=your-diyanet-password

# Comma-separated origins allowed to use the proxy from a browser ("*" = any origin, not recommended)
ALLOWED_ORIGINS=https://your-niltab-domain.com

# Set to 1 only when running behind a reverse proxy (nginx/Cloudflare) that sets X-Forwarded-For
TRUST_PROXY=0

# Max requests per minute per client IP that are forwarded to Diyanet (cache hits are not counted)
RATE_LIMIT_PER_MIN=30
